rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /ads/{adId} {
      // Public: anyone can read an ad only if it's approved — pending/
      // rejected ads are never publicly visible. The active-date-range
      // check happens client-side (ads.js) instead of here: Firestore
      // rejects an entire LIST query outright if the rule references a
      // field not covered by the query's own filters (startDate/endDate
      // here), since it can't prove the whole result set is safe without
      // reading it first — so a date check here would silently break
      // every unauthenticated read, not just filter out expired ads. A
      // signed-in admin (you) can read everything, including pending.
      allow read: if resource.data.status == 'approved' || request.auth != null;

      // Public: anyone can submit a new ad, but only as 'pending' — they
      // cannot self-approve.
      allow create: if request.resource.data.status == 'pending';

      // Only a signed-in admin (you) can approve/reject/delete.
      allow update, delete: if request.auth != null;
    }
  }
}
